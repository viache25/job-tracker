# Copy to .env (not committed) or set as EAS environment variables.
# RevenueCat public SDK keys (Project settings → API keys). Without them purchases are off.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Sentry DSN; crash reports are sent only from release builds when set.
EXPO_PUBLIC_SENTRY_DSN=
